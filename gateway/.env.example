# MCP server identity is supplied by the trusted process configuration.
GATEWAY_PRINCIPAL_ID=local-analyst
GATEWAY_PRINCIPAL_ROLES_JSON={"local-analyst":"analyst"}
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
# Set true to log up to 2000 characters of tool output; may expose sensitive data.
GATEWAY_LOG_TOOL_RESULTS=false

# MySQL security control plane (the MySQL service from the repository compose file).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_DATABASE=agentic_bi
MYSQL_USER=bi_agent
MYSQL_PASSWORD=bi_agent_pass


# The Gateway serves MCP over SSE and starts its upstream MCP server over stdio.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS_JSON=["-m","trino_mcp"]
# Defaults to this repository's trino-mcp directory.
# MCP_SERVER_CWD=/path/to/secure_agentic_BI/trino-mcp
MCP_TIMEOUT_SECONDS=30
GATEWAY_EXPORT_ROOT=./exports
GATEWAY_PII_TABLES=customers,employees,customer_profiles
