# ============================================================
# Trino MCP Server – Environment Configuration
# Project: Secure Agentic BI Framework
# ============================================================

# --- Trino Connection ---
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=admin
TRINO_HTTP_SCHEME=http

# --- Authentication ---
# NONE = no password, phù hợp Trino dev mặc định
AUTH_METHOD=NONE

# --- Query Execution Permissions ---
# Chặn hoàn toàn quyền ghi (INSERT/UPDATE/DELETE/CREATE/DROP)
# Chỉ cho phép tool execute_query_read_only hoạt động
ALLOW_WRITE_QUERIES=false

# --- DoS Defense: Query Timeout ---
# Giới hạn thời gian chạy tối đa cho MỖI query.
# Query vượt quá 2 phút sẽ bị cancel phía client + server (cursor.cancel).
QUERY_TIMEOUT_MINUTES=2

# --- DoS Defense: Concurrency Limit ---
# Chỉ cho phép 1 query chạy đồng thời (asyncio.Semaphore(1)).
# Request thứ 2 trở đi bị reject ngay lập tức với thông báo lỗi.
MAX_CONCURRENT_QUERIES=1
